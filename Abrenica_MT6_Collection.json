  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Response body is valid JSON\", function () {",
                  "    pm.expect(function () {",
                  "        pm.response.json();",
                  "    }).to.not.throw();",
                  "});",
                  "",
                  "const responseJson = pm.response.json();",
                  "",
                  "pm.test(\"Token exists and is a non-empty string\", function () {",
                  "    pm.expect(responseJson).to.have.property(\"token\");",
                  "    pm.expect(responseJson.token).to.be.a(\"string\");",
                  "    pm.expect(responseJson.token.trim().length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"User object exists\", function () {",
                  "    pm.expect(responseJson).to.have.property(\"user\");",
                  "    pm.expect(responseJson.user).to.be.an(\"object\");",
                  "    pm.expect(responseJson.user).to.not.equal(null);",
                  "});",
                  "",
                  "pm.test(\"User email matches request body email if available\", function () {",
                  "    let requestEmail;",
                  "",
                  "    try {",
                  "        const requestBodyRaw = pm.request.body && pm.request.body.raw;",
                  "        if (requestBodyRaw) {",
                  "            const requestJson = JSON.parse(requestBodyRaw);",
                  "            requestEmail = requestJson.email;",
                  "        }",
                  "    } catch (e) {}",
                  "",
                  "    if (requestEmail) {",
                  "        pm.expect(responseJson.user).to.have.property(\"email\");",
                  "        pm.expect(responseJson.user.email).to.eql(requestEmail);",
                  "    } else {",
                  "        pm.expect(true).to.be.true;",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
